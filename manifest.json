{
    "manifest_version": 3,
    "name": "YouTube Focus AI",
    "version": "1.0",
    "description": "AI-Guided YouTube Focus Enforcer",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://*.youtube.com/*",
        "https://api.minimax.chat/*",
        "https://api.minimax.io/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",
    "action": {
        "default_title": "YouTube Focus"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "css": [
                "styles.css"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icons/focus16.png",
        "48": "icons/focus48.png",
        "128": "icons/focus128.png"
    }
}